{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{
					"color": "#FFFFFF",
					"name": "Base",
					"slug": "base"
				},
				{
					"color": "#F7F7F5",
					"name": "Base Secondary",
					"slug": "base-2"
				},
				{
					"color": "#1A1A1A",
					"name": "Contrast",
					"slug": "contrast"
				},
				{
					"color": "#4A4A4A",
					"name": "Contrast Secondary",
					"slug": "contrast-2"
				},
				{
					"color": "#1A3353",
					"name": "Primary",
					"slug": "primary"
				},
				{
					"color": "#2A4F80",
					"name": "Primary Light",
					"slug": "primary-light"
				},
				{
					"color": "#C2412A",
					"name": "Accent",
					"slug": "accent"
				},
				{
					"color": "#FF8066",
					"name": "Accent Light",
					"slug": "accent-light"
				},
				{
					"color": "#6B6B6B",
					"name": "Muted",
					"slug": "muted"
				},
				{
					"color": "#E2E2E2",
					"name": "Line",
					"slug": "line"
				}
			],
			"gradients": [
				{
					"gradient": "linear-gradient(135deg, var(--wp--preset--color--primary) 0%, var(--wp--preset--color--primary-light) 100%)",
					"name": "Primary Gradient",
					"slug": "primary-gradient"
				},
				{
					"gradient": "linear-gradient(135deg, var(--wp--preset--color--contrast) 0%, var(--wp--preset--color--primary) 100%)",
					"name": "Dark Gradient",
					"slug": "dark-gradient"
				}
			]
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1200px"
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"name": "SM",
					"shadow": "0 1px 3px 0 rgba(0,0,0,0.08), 0 1px 2px -1px rgba(0,0,0,0.06)",
					"slug": "sm"
				},
				{
					"name": "MD",
					"shadow": "0 4px 6px -1px rgba(0,0,0,0.08), 0 2px 4px -2px rgba(0,0,0,0.06)",
					"slug": "md"
				},
				{
					"name": "LG",
					"shadow": "0 10px 15px -3px rgba(0,0,0,0.08), 0 4px 6px -4px rgba(0,0,0,0.05)",
					"slug": "lg"
				},
				{
					"name": "XL",
					"shadow": "0 20px 25px -5px rgba(0,0,0,0.12), 0 8px 10px -6px rgba(0,0,0,0.08)",
					"slug": "xl"
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"name": "1",
					"size": "0.25rem",
					"slug": "10"
				},
				{
					"name": "2",
					"size": "0.5rem",
					"slug": "20"
				},
				{
					"name": "3",
					"size": "0.75rem",
					"slug": "30"
				},
				{
					"name": "4",
					"size": "1rem",
					"slug": "40"
				},
				{
					"name": "5",
					"size": "1.5rem",
					"slug": "50"
				},
				{
					"name": "6",
					"size": "clamp(1.25rem, 4vw, 2rem)",
					"slug": "60"
				},
				{
					"name": "7",
					"size": "clamp(2rem, 5vw, 3rem)",
					"slug": "70"
				},
				{
					"name": "8",
					"size": "clamp(2.5rem, 6vw, 4rem)",
					"slug": "80"
				},
				{
					"name": "9",
					"size": "clamp(3rem, 8vw, 6rem)",
					"slug": "90"
				},
				{
					"name": "10",
					"size": "clamp(4rem, 10vw, 8rem)",
					"slug": "100"
				}
			],
			"units": [
				"%",
				"px",
				"em",
				"rem",
				"vh",
				"vw"
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": {
				"minViewportWidth": "360px",
				"maxViewportWidth": "1280px"
			},
			"fontFamilies": [
				{
					"fontFamily": "Inter, 'Inter Fallback', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
					"name": "Inter",
					"slug": "inter",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/inter/Inter-Variable.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Inter",
							"fontStyle": "italic",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/inter/Inter-Variable-Italic.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						}
					]
				},
				{
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace",
					"name": "System Mono",
					"slug": "system-mono"
				}
			],
			"fontSizes": [
				{
					"fluid": false,
					"name": "XS",
					"size": "0.8125rem",
					"slug": "xs"
				},
				{
					"fluid": false,
					"name": "SM",
					"size": "0.9375rem",
					"slug": "sm"
				},
				{
					"fluid": {
						"min": "1.125rem",
						"max": "1.25rem"
					},
					"name": "MD",
					"size": "1.25rem",
					"slug": "md"
				},
				{
					"fluid": {
						"min": "1.25rem",
						"max": "1.375rem"
					},
					"name": "LG",
					"size": "1.375rem",
					"slug": "lg"
				},
				{
					"fluid": {
						"min": "1.375rem",
						"max": "1.5rem"
					},
					"name": "XL",
					"size": "1.5rem",
					"slug": "xl"
				},
				{
					"fluid": {
						"min": "1.5rem",
						"max": "1.75rem"
					},
					"name": "2XL",
					"size": "1.75rem",
					"slug": "2xl"
				},
				{
					"fluid": {
						"min": "1.75rem",
						"max": "2.125rem"
					},
					"name": "3XL",
					"size": "2.125rem",
					"slug": "3xl"
				},
				{
					"fluid": {
						"min": "2rem",
						"max": "2.5rem"
					},
					"name": "4XL",
					"size": "2.5rem",
					"slug": "4xl"
				},
				{
					"fluid": {
						"min": "2.25rem",
						"max": "3.25rem"
					},
					"name": "5XL",
					"size": "3.25rem",
					"slug": "5xl"
				},
				{
					"fluid": {
						"min": "2.75rem",
						"max": "4.5rem"
					},
					"name": "Huge",
					"size": "4.5rem",
					"slug": "huge"
				}
			]
		},
		"blocks": {
			"core/image": {
				"lightbox": {
					"allowEditing": true
				}
			}
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": {
				"top": "0",
				"right": "var(--lede--gutter, 16px)",
				"bottom": "0",
				"left": "var(--lede--gutter, 16px)"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|inter",
			"fontSize": "var:preset|font-size|md",
			"fontWeight": "400",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontWeight": "700",
					"lineHeight": "1.25"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|5-xl",
					"letterSpacing": "-0.025em",
					"lineHeight": "1.15"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|4-xl",
					"letterSpacing": "-0.02em"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|3-xl",
					"fontWeight": "600",
					"lineHeight": "1.35"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var:preset|font-size|2-xl",
					"fontWeight": "600",
					"lineHeight": "1.4"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var:preset|font-size|xl",
					"fontWeight": "600",
					"lineHeight": "1.5"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var:preset|font-size|lg",
					"fontWeight": "600",
					"lineHeight": "1.5"
				}
			},
			"link": {
				"color": {
					"text": "var:preset|color|primary"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|accent"
					}
				}
			},
			"button": {
				"border": {
					"radius": "0.375rem"
				},
				"color": {
					"background": "var:preset|color|contrast",
					"text": "var:preset|color|base"
				},
				"spacing": {
					"padding": {
						"top": "0.75rem",
						"right": "1.5rem",
						"bottom": "0.75rem",
						"left": "1.5rem"
					}
				},
				"typography": {
					"fontSize": "var:preset|font-size|sm",
					"fontWeight": "600",
					"letterSpacing": "0.01em",
					"lineHeight": "1.4"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|primary",
						"text": "var:preset|color|base"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var:preset|color|muted"
				},
				"typography": {
					"fontSize": "var:preset|font-size|sm"
				}
			}
		},
		"blocks": {
			"core/button": {
				"variations": {
					"outline": {
						"border": {
							"color": "currentColor",
							"width": "2px"
						},
						"color": {
							"background": "transparent",
							"text": "currentColor"
						},
						"spacing": {
							"padding": {
								"top": "calc(0.75rem - 2px)",
								"right": "calc(1.5rem - 2px)",
								"bottom": "calc(0.75rem - 2px)",
								"left": "calc(1.5rem - 2px)"
							}
						}
					}
				}
			},
			"core/code": {
				"border": {
					"radius": "0.375rem"
				},
				"color": {
					"background": "var:preset|color|base-2"
				},
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|50",
						"right": "var:preset|spacing|60",
						"bottom": "var:preset|spacing|50",
						"left": "var:preset|spacing|60"
					}
				},
				"typography": {
					"fontFamily": "var:preset|font-family|system-mono",
					"fontSize": "var:preset|font-size|sm"
				}
			},
			"core/comment-author-name": {
				"typography": {
					"fontWeight": "600"
				}
			},
			"core/comment-date": {
				"color": {
					"text": "var:preset|color|muted"
				},
				"typography": {
					"fontSize": "var:preset|font-size|xs"
				}
			},
			"core/details": {
				"border": {
					"bottom": {
						"color": "var:preset|color|line",
						"style": "solid",
						"width": "1px"
					}
				},
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|40",
						"bottom": "var:preset|spacing|40"
					}
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var:preset|font-size|sm",
					"fontWeight": "500"
				}
			},
			"core/post-date": {
				"color": {
					"text": "var:preset|color|muted"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|muted"
						}
					}
				}
			},
			"core/post-terms": {
				"typography": {
					"fontSize": "var:preset|font-size|xs",
					"fontWeight": "700",
					"letterSpacing": "0.08em",
					"textTransform": "uppercase"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|accent"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/post-title": {
				"typography": {
					"lineHeight": "1.2"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|contrast"
						},
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"color": {
								"text": "var:preset|color|primary"
							}
						}
					}
				}
			},
			"core/preformatted": {
				"border": {
					"radius": "0.375rem"
				},
				"color": {
					"background": "var:preset|color|base-2"
				},
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|50",
						"right": "var:preset|spacing|60",
						"bottom": "var:preset|spacing|50",
						"left": "var:preset|spacing|60"
					}
				},
				"typography": {
					"fontFamily": "var:preset|font-family|system-mono",
					"fontSize": "var:preset|font-size|sm"
				}
			},
			"core/pullquote": {
				"border": {
					"color": "var:preset|color|primary",
					"style": "solid",
					"width": "2px 0"
				},
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|60",
						"bottom": "var:preset|spacing|60"
					}
				},
				"typography": {
					"fontSize": "var:preset|font-size|2-xl",
					"fontStyle": "italic"
				}
			},
			"core/quote": {
				"variations": {
					"plain": {
						"border": {
							"width": "0"
						},
						"spacing": {
							"padding": {
								"left": "0"
							}
						}
					}
				},
				"border": {
					"left": {
						"color": "var:preset|color|primary",
						"style": "solid",
						"width": "4px"
					}
				},
				"spacing": {
					"padding": {
						"left": "var:preset|spacing|60"
					}
				},
				"typography": {
					"fontSize": "var:preset|font-size|xl",
					"fontStyle": "italic",
					"lineHeight": "1.6"
				},
				"elements": {
					"cite": {
						"color": {
							"text": "var:preset|color|muted"
						},
						"typography": {
							"fontSize": "var:preset|font-size|sm",
							"fontStyle": "normal"
						}
					}
				}
			},
			"core/search": {
				"css": "& .wp-block-search__input{border-color:var(--wp--preset--color--line);border-radius:0.375rem;padding:0.625rem 0.875rem}& .wp-block-search__button{border-radius:0.375rem}"
			},
			"core/separator": {
				"color": {
					"text": "var:preset|color|line"
				}
			},
			"core/site-title": {
				"typography": {
					"fontSize": "var:preset|font-size|xl",
					"fontWeight": "700",
					"letterSpacing": "-0.01em"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|contrast"
						},
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"color": {
								"text": "var:preset|color|primary"
							}
						}
					}
				}
			},
			"core/table": {
				"css": "& td,& th{padding:0.75rem 1rem;border-color:var(--wp--preset--color--line)}& th{background:var(--wp--preset--color--base-2);font-weight:600;text-align:start}"
			}
		}
	},
	"customTemplates": [
		{
			"name": "page-full-width",
			"postTypes": [
				"page"
			],
			"title": "Wide Page"
		},
		{
			"name": "page-no-title",
			"postTypes": [
				"page",
				"post"
			],
			"title": "Page (No Title)"
		},
		{
			"name": "single-with-sidebar",
			"postTypes": [
				"post"
			],
			"title": "Post with Sidebar"
		}
	],
	"templateParts": [
		{
			"area": "header",
			"name": "header",
			"title": "Header"
		},
		{
			"area": "footer",
			"name": "footer",
			"title": "Footer"
		},
		{
			"area": "uncategorized",
			"name": "sidebar",
			"title": "Sidebar"
		}
	]
}
