msgid "Lede"
msgstr ""

#. Theme URI of the theme
#: style.css
msgid "https://github.com/dhirenpatel22/lede"
msgstr ""

#. Description of the theme
#: style.css
msgid "A fast, accessible block theme for blogs, publishers and business sites. No theme JavaScript, one self-hosted variable font and zero layout shift. Includes blog templates, a post layout with a 300px sidebar, 13 patterns (hero, features, stats, testimonials, pricing, FAQ, team and more) and fixed breakpoints at 600, 768, 1024 and 1280px."
msgstr ""

