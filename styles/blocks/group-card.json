{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"title": "Card",
	"slug": "card",
	"blockTypes": [ "core/group", "core/column" ],
	"styles": {
		"border": {
			"color": "var:preset|color|line",
			"radius": "0.75rem",
			"style": "solid",
			"width": "1px"
		},
		"color": {
			"background": "var:preset|color|base"
		},
		"shadow": "var:preset|shadow|sm",
		"spacing": {
			"padding": {
				"top": "var:preset|spacing|60",
				"right": "var:preset|spacing|60",
				"bottom": "var:preset|spacing|60",
				"left": "var:preset|spacing|60"
			}
		}
	}
}
